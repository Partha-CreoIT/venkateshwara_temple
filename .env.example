# Temple content database (members, events) — Postgres
DATABASE_URL=postgres://user@localhost:5432/temple_dev

# rbac-db auth/RBAC backend (Go service) — used for admin login + roles
RBAC_API_URL=http://localhost:8080/api/v1

# Public events feed shown on the landing page (browser-side fetch, read-only).
# Defaults to the rbac-db events endpoint above if unset.
NEXT_PUBLIC_EVENTS_API_URL=http://localhost:8080/api/v1
